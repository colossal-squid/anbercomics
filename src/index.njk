---
title: "Головна"
layout: base.njk
lang: uk
permalink: "index.html"
---

{% include "card.njk" %}

<section class="mt-8">
  <h2 class="text-lg font-semibold mb-4">Пости</h2>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {% for post in collections.posts | byLang('uk') %}
      <a href="{{ post.url | withPrefix(site.pathPrefix) }}" class="card block group bg-zinc-900/50 border border-zinc-800 rounded-xl overflow-hidden focus:outline-none">
        {% if post.data.image %}
          <img src="{{ post.data.image | withPrefix(site.pathPrefix) }}" alt="{{ post.data.alt or post.data.title }}" class="w-full h-48 object-cover group-hover:opacity-90 transition">
        {% endif %}
        <div class="p-4">
          <h3 class="font-medium">{{ post.data.title }}</h3>
          {% if post.data.excerpt %}
            <p class="text-sm text-zinc-400 mt-1">{{ post.data.excerpt }}</p>
          {% endif %}
        </div>
      </a>
    {% endfor %}
  </div>
</section>
