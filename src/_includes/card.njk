<div class="w-full bg-zinc-900/60 border border-zinc-800 rounded-2xl p-5 md:p-6 shadow-xl">
  <div class="flex flex-col md:flex-row items-center gap-5">
    <img src="{{ site[lang].avatar | withPrefix(site.pathPrefix) }}" alt="{{ site[lang].name }}" class="w-24 h-24 rounded-full ring-2 ring-zinc-700 object-cover">
    <div class="text-center md:text-left flex-1">
      <h1 class="text-2xl md:text-3xl font-bold tracking-tight">{{ site[lang].name }}</h1>
      <p class="mt-2 text-zinc-300">{{ site[lang].bio }}</p>

      {% if site.youtube %}
        <div class="mt-3">
          <a href="{{ site.youtube }}" target="_blank" rel="noopener noreferrer"
             class="inline-flex items-center px-3 py-1.5 text-sm font-medium rounded-lg bg-red-600 text-white hover:bg-red-700 transition">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19.615 3.184A3.006 3.006 0 0 0 17.5 2.94C15.067 2.75 12.633 2.75 10.2 2.75c-2.434 0-4.867 0-7.3.19a3.006 3.006 0 0 0-2.115.244A3.012 3.012 0 0 0 .244 5.249C.05 7.683.05 10.117.05 12.55c0 2.433 0 4.867.194 7.3.09.888.479 1.693 1.146 2.31.667.617 1.525.962 2.426.994 2.37.19 4.74.19 7.11.19s4.74 0 7.11-.19a3.006 3.006 0 0 0 2.426-.994c.667-.617 1.056-1.422 1.146-2.31.194-2.433.194-4.867.194-7.3 0-2.433 0-4.867-.194-7.301a3.006 3.006 0 0 0-1.146-2.31 3.006 3.006 0 0 0-2.115-.244ZM9.75 15.585V9.515L15.25 12.55l-5.5 3.035Z"/>
            </svg>
            YouTube
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</div>